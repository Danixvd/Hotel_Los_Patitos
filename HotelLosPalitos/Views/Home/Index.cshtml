@{
    ViewData["Title"] = "Inicio";
}

<div class="editorial-hero">
    <div>
        <div class="eyebrow">Sistema de reservaciones</div>
        <h1 class="editorial-title">Hotel Los <em>Patitos</em></h1>
        <p class="editorial-lede">
            Gestiona habitaciones, reservaciones y el historico completo del hotel
            desde un solo lugar, pensado para tu equipo administrativo y tus huespedes.
        </p>
        <a asp-controller="Reservas" asp-action="Index" class="btn btn-primary btn-lg">
            <i class="bi bi-search"></i> Ver habitaciones disponibles
        </a>
    </div>
    <div class="editorial-aside">
        <div class="editorial-aside-item">
            <span class="editorial-aside-num">01</span>
            <span class="editorial-aside-title">Habitaciones</span>
            <div class="section-index-text mb-0">Registra y controla el estado de cada habitacion.</div>
        </div>
        <div class="editorial-aside-item">
            <span class="editorial-aside-num">02</span>
            <span class="editorial-aside-title">Reservas</span>
            <div class="section-index-text mb-0">Consulta disponibilidad y confirma una reservacion.</div>
        </div>
        <div class="editorial-aside-item">
            <span class="editorial-aside-num">03</span>
            <span class="editorial-aside-title">Historico</span>
            <div class="section-index-text mb-0">Revisa todas las reservaciones registradas.</div>
        </div>
    </div>
</div>

<div class="section-index">
    <div class="section-index-item">
        <div class="section-index-num">01 — Gestion</div>
        <h3 class="section-index-title">Habitaciones</h3>
        <p class="section-index-text">Administra las habitaciones del hotel: registra, edita y consulta el estado de cada una.</p>
        <a asp-controller="Habitaciones" asp-action="Index" class="btn btn-primary btn-sm">
            Ir a Habitaciones
        </a>
    </div>
    <div class="section-index-item">
        <div class="section-index-num">02 — Huespedes</div>
        <h3 class="section-index-title">Reservas</h3>
        <p class="section-index-text">Consulta las habitaciones disponibles, realiza una reserva o busca una reservacion existente.</p>
        <a asp-controller="Reservas" asp-action="Index" class="btn btn-primary btn-sm">
            Ir a Reservas
        </a>
    </div>
    <div class="section-index-item">
        <div class="section-index-num">03 — Control</div>
        <h3 class="section-index-title">Reserva administrativa</h3>
        <p class="section-index-text">Consulta el historico completo de todas las reservaciones, con filtro por habitacion.</p>
        <a asp-controller="ReservasAdmin" asp-action="Index" class="btn btn-primary btn-sm">
            Ir a Reserva administrativa
        </a>
    </div>
</div>

<h2>Tipos de habitacion</h2>
<div class="room-type-index">
    <div class="room-type-row">
        <span class="room-type-num">01</span>
        <span class="room-type-name">Junior</span>
        <span class="room-type-desc">Ideal para estadias cortas y viajeros individuales.</span>
    </div>
    <div class="room-type-row">
        <span class="room-type-num">02</span>
        <span class="room-type-name">Superior</span>
        <span class="room-type-desc">Mas espacio y comodidad para familias o parejas.</span>
    </div>
    <div class="room-type-row">
        <span class="room-type-num">03</span>
        <span class="room-type-name">Suite</span>
        <span class="room-type-desc">La maxima experiencia de lujo y confort en el hotel.</span>
    </div>
</div>

<div class="feature-strip mb-4">
    <div class="feature-strip-item"><i class="bi bi-shield-check"></i> Reservas seguras</div>
    <div class="feature-strip-item"><i class="bi bi-clock-history"></i> Disponibilidad en tiempo real</div>
    <div class="feature-strip-item"><i class="bi bi-cash-coin"></i> Precios transparentes</div>
    <div class="feature-strip-item"><i class="bi bi-headset"></i> Atencion personalizada</div>
</div>

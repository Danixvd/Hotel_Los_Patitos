@model HotelLosPalitos.ViewModels.ReservaHistoricoViewModel

@{
    ViewData["Title"] = "Reserva administrativa";
}

<h2>Historico de reservas</h2>

<form asp-controller="ReservasAdmin" asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <label class="form-label">Filtrar por Id de habitacion</label>
        <input type="number" name="idHabitacion" value="@Model.IdHabitacionFiltro"
               class="form-control" placeholder="Id de la habitacion" />
    </div>
    <div class="col-auto align-self-end">
        <button type="submit" class="btn btn-primary">Filtrar</button>
        <a asp-controller="ReservasAdmin" asp-action="Index" class="btn btn-secondary">Limpiar filtro</a>
    </div>
</form>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>Nombre de persona</th>
            <th>Telefono</th>
            <th>Correo</th>
            <th>Identificacion</th>
            <th>Monto total</th>
            <th>Fecha de nacimiento</th>
            <th>Fecha inicio reservacion</th>
            <th>Fecha fin reservacion</th>
            <th>Fecha de registro</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Reservas.Any())
        {
            <tr>
                <td colspan="9" class="text-center">No hay reservas registradas.</td>
            </tr>
        }
        else
        {
            @foreach (var reserva in Model.Reservas)
            {
                <tr>
                    <td>@reserva.NombreDePersona</td>
                    <td>@reserva.Telefono</td>
                    <td>@reserva.Correo</td>
                    <td>@reserva.Identificacion</td>
                    <td>@reserva.MontoTotal.ToString("C2")</td>
                    <td>@reserva.FechaNacimiento.ToString("dd/MM/yyyy")</td>
                    <td>@reserva.FechaInicioReservacion.ToString("dd/MM/yyyy")</td>
                    <td>@reserva.FechaFinReservacion.ToString("dd/MM/yyyy")</td>
                    <td>@reserva.FechaDeRegistro.ToString("dd/MM/yyyy HH:mm")</td>
                </tr>
            }
        }
    </tbody>
</table>
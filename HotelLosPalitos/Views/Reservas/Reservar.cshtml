@model HotelLosPalitos.ViewModels.ReservaFormViewModel

@{
    ViewData["Title"] = "Reservar habitacion";
}

<h2>Reservar habitacion</h2>

<div asp-validation-summary="All" class="text-danger"></div>

<form asp-controller="Reservas" asp-action="Reservar" method="post">
    <input type="hidden" asp-for="IdHabitacion" />
    <input type="hidden" asp-for="CodigoDeHabitacion" />
    <input type="hidden" asp-for="NombreDeHabitacion" />
    <input type="hidden" asp-for="TipoDeHabitacionTexto" />
    <input type="hidden" asp-for="CostoDeReserva" />
    <input type="hidden" asp-for="CostoDeLimpieza" />

    <div class="booking-grid">
        <div class="card shadow-sm">
            <div class="card-body p-4">

                <div class="form-section-title"><i class="bi bi-person-badge"></i> Datos del huesped</div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="NombreDeLaPersona" class="form-label"></label>
                        <input asp-for="NombreDeLaPersona" class="form-control" />
                        <span asp-validation-for="NombreDeLaPersona" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Identificacion" class="form-label"></label>
                        <input asp-for="Identificacion" class="form-control" />
                        <span asp-validation-for="Identificacion" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Telefono" class="form-label"></label>
                        <input asp-for="Telefono" class="form-control" />
                        <span asp-validation-for="Telefono" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Correo" class="form-label"></label>
                        <input asp-for="Correo" class="form-control" type="email" />
                        <span asp-validation-for="Correo" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="FechaNacimiento" class="form-label"></label>
                        <input asp-for="FechaNacimiento" class="form-control" type="date" />
                        <span asp-validation-for="FechaNacimiento" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Direccion" class="form-label"></label>
                        <input asp-for="Direccion" class="form-control" />
                        <span asp-validation-for="Direccion" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-section-title"><i class="bi bi-calendar-range"></i> Detalles de la estadia</div>
                <div class="row g-3">
                    <div class="col-md-4">
                        <label asp-for="CantidadDePersonas" class="form-label"></label>
                        <input asp-for="CantidadDePersonas" class="form-control" type="number" />
                        <span asp-validation-for="CantidadDePersonas" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="FechaInicioReserva" class="form-label"></label>
                        <input asp-for="FechaInicioReserva" class="form-control" type="date" />
                        <span asp-validation-for="FechaInicioReserva" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="FechaFinReserva" class="form-label"></label>
                        <input asp-for="FechaFinReserva" class="form-control" type="date" />
                        <span asp-validation-for="FechaFinReserva" class="text-danger"></span>
                    </div>
                </div>

                <div class="mt-4">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-circle"></i> Confirmar reserva
                    </button>
                    <a asp-controller="Reservas" asp-action="Index" class="btn btn-secondary">Cancelar</a>
                </div>
            </div>
        </div>

        <div class="booking-summary">
            <div class="summary-card">
                <div class="summary-card-header">
                    <div class="room-card-subtype">Resumen de la habitacion</div>
                    <div class="room-card-type">@Model.NombreDeHabitacion</div>
                    <div class="room-card-subtype">Codigo @Model.CodigoDeHabitacion</div>
                </div>
                <div class="p-3">
                    <div class="summary-row">
                        <span class="label">Tipo</span>
                        <span class="value">@Model.TipoDeHabitacionTexto</span>
                    </div>
                    <div class="summary-row">
                        <span class="label">Costo por noche</span>
                        <span class="value">@Model.CostoDeReserva.ToString("C2")</span>
                    </div>
                    <div class="summary-row">
                        <span class="label">Costo de limpieza</span>
                        <span class="value">@Model.CostoDeLimpieza.ToString("C2")</span>
                    </div>
                    <p class="room-card-meta mt-3 mb-0" style="font-size: 0.82rem;">
                        <i class="bi bi-info-circle"></i> El monto total se calcula segun las fechas de la reserva.
                    </p>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

@model HotelLosPalitos.ViewModels.ReservaDetailsViewModel

@{
    ViewData["Title"] = "Detalles de reservacion";
}

<h2>Detalles de la reservacion</h2>

<div class="detail-card">
    <div class="detail-card-header">
        <i class="bi bi-calendar-check"></i> Reservacion #@Model.Id
    </div>
    <div class="p-4">
        @await Html.PartialAsync("DetallesReserva", Model)

        <a asp-controller="Reservas" asp-action="Index" class="btn btn-secondary mt-4">
            <i class="bi bi-arrow-left"></i> Volver al listado
        </a>
    </div>
</div>

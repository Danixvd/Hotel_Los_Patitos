@model List<HotelLosPalitos.ViewModels.ReservaListItemViewModel>

@{
    ViewData["Title"] = "Reservas";
}

<h2>Habitaciones disponibles</h2>

@if (TempData["MensajeNoEncontrada"] != null)
{
    <div class="alert alert-warning">@TempData["MensajeNoEncontrada"]</div>
}

@if (TempData["MensajeExito"] != null)
{
    <div class="alert alert-success">@TempData["MensajeExito"]</div>
}

<div class="card mb-4">
    <div class="card-body">
        <h5 class="card-title">Buscar reserva por numero de reservacion</h5>
        <form asp-controller="Reservas" asp-action="Buscar" method="post" class="row g-2">
            <div class="col-auto">
                <input type="number" name="idReservacion" class="form-control"
                       placeholder="Numero de reservacion" required />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary">Buscar</button>
            </div>
        </form>
    </div>
</div>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>Nombre de habitacion</th>
            <th>Huespedes</th>
            <th>Camas</th>
            <th>Banos</th>
            <th>Ubicacion</th>
            <th>Costo por noche</th>
            <th>Tipo</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr>
                <td colspan="8" class="text-center">No hay habitaciones disponibles para reservar.</td>
            </tr>
        }
        else
        {
            @foreach (var habitacion in Model)
            {
                <tr>
                    <td>@habitacion.NombreDeHabitacion</td>
                    <td>@habitacion.CantidadDeHuespedes</td>
                    <td>@habitacion.CantidadDeCamas</td>
                    <td>@habitacion.CantidadDeBanos</td>
                    <td>@habitacion.Ubicacion</td>
                    <td>@habitacion.CostoPorNoche.ToString("C2")</td>
                    <td>@habitacion.TipoDeHabitacionTexto</td>
                    <td>
                        <a asp-controller="Reservas" asp-action="Reservar" asp-route-id="@habitacion.IdHabitacion"
                           class="btn btn-sm btn-success">Reservar</a>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>
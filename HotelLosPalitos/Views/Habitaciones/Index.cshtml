@model List<HotelLosPalitos.ViewModels.HabitacionListItemViewModel>

@{
    ViewData["Title"] = "Habitaciones";
}

<h2>Habitaciones</h2>

@if (TempData["MensajeExito"] != null)
{
    <div class="alert alert-success">@TempData["MensajeExito"]</div>
}

<p>
    <a asp-controller="Habitaciones" asp-action="Registrar" class="btn btn-primary">
        Registrar nueva habitacion
    </a>
</p>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>Codigo</th>
            <th>Nombre</th>
            <th>Ubicacion</th>
            <th>Huespedes</th>
            <th>Camas</th>
            <th>Banos</th>
            <th>Encargado de limpieza</th>
            <th>Costo limpieza</th>
            <th>Costo reserva</th>
            <th>Tipo</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var habitacion in Model)
        {
            <tr>
                <td>@habitacion.CodigoDeHabitacion</td>
                <td>@habitacion.NombreDeHabitacion</td>
                <td>@habitacion.Ubicacion</td>
                <td>@habitacion.CantidadDeHuespedesPermitidos</td>
                <td>@habitacion.CantidadDeCamas</td>
                <td>@habitacion.CantidadDeBanos</td>
                <td>@habitacion.EncargadoDeLimpieza</td>
                <td>@habitacion.CostoDeLimpieza.ToString("C2")</td>
                <td>@habitacion.CostoDeReserva.ToString("C2")</td>
                <td>@habitacion.TipoDeHabitacionTexto</td>
                <td>
                    @if (habitacion.Estado)
                    {
                        <span class="badge bg-success">Activo</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Inactivo</span>
                    }
                </td>
                <td>
                    <a asp-controller="Habitaciones" asp-action="Editar" asp-route-id="@habitacion.Id"
                       class="btn btn-sm btn-warning">Editar</a>
                    <a asp-controller="ReservasAdmin" asp-action="Index" asp-route-idHabitacion="@habitacion.Id"
                       class="btn btn-sm btn-info">Ver reservas</a>
                </td>
            </tr>
        }
    </tbody>
</table>
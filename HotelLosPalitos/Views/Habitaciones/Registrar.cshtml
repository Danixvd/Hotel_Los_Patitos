@model HotelLosPalitos.ViewModels.HabitacionFormViewModel

@{
    ViewData["Title"] = "Registrar habitacion";
}

<h2>Registrar habitacion</h2>

<div asp-validation-summary="All" class="text-danger"></div>

<div class="card shadow-sm">
    <div class="card-body p-4">
        <form asp-controller="Habitaciones" asp-action="Registrar" method="post">
    <div class="mb-3">
        <label asp-for="CodigoDeHabitacion" class="form-label"></label>
        <input asp-for="CodigoDeHabitacion" class="form-control" />
        <span asp-validation-for="CodigoDeHabitacion" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="NombreDeHabitacion" class="form-label"></label>
        <input asp-for="NombreDeHabitacion" class="form-control" />
        <span asp-validation-for="NombreDeHabitacion" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Ubicacion" class="form-label"></label>
        <input asp-for="Ubicacion" class="form-control" />
        <span asp-validation-for="Ubicacion" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="CantidadDeHuespedesPermitidos" class="form-label"></label>
        <input asp-for="CantidadDeHuespedesPermitidos" class="form-control" type="number" />
        <span asp-validation-for="CantidadDeHuespedesPermitidos" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="CantidadDeCamas" class="form-label"></label>
        <input asp-for="CantidadDeCamas" class="form-control" type="number" />
        <span asp-validation-for="CantidadDeCamas" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="CantidadDeBanos" class="form-label"></label>
        <input asp-for="CantidadDeBanos" class="form-control" type="number" />
        <span asp-validation-for="CantidadDeBanos" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="EncargadoDeLimpieza" class="form-label"></label>
        <input asp-for="EncargadoDeLimpieza" class="form-control" />
        <span asp-validation-for="EncargadoDeLimpieza" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="TipoDeHabitacion" class="form-label"></label>
        <select asp-for="TipoDeHabitacion" class="form-select">
            <option value="1">Junior</option>
            <option value="2">Superior</option>
            <option value="3">Suite</option>
        </select>
        <span asp-validation-for="TipoDeHabitacion" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="CostoDeLimpieza" class="form-label"></label>
        <input asp-for="CostoDeLimpieza" class="form-control" type="number" step="0.01" />
        <span asp-validation-for="CostoDeLimpieza" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="CostoDeReserva" class="form-label"></label>
        <input asp-for="CostoDeReserva" class="form-control" type="number" step="0.01" />
        <span asp-validation-for="CostoDeReserva" class="text-danger"></span>
    </div>

    <div class="mb-3 form-check">
        <input asp-for="Estado" class="form-check-input" />
        <label asp-for="Estado" class="form-check-label"></label>
    </div>

            <button type="submit" class="btn btn-primary">Guardar</button>
            <a asp-controller="Habitaciones" asp-action="Index" class="btn btn-secondary">Cancelar</a>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}